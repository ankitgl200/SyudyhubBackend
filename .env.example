# StudyMyte Server Configuration Template
PORT=5000
NODE_ENV=development
JWT_SECRET=your_long_cryptographically_random_jwt_secret_here
MONGODB_URI=mongodb://127.0.0.1:27017/studymyte

# Google Gemini API Configuration (for MYTEE Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.3

# MYTEE Rate Limiting & Protections
MYTEE_STUDENT_RATE_LIMIT_MIN=10
MYTEE_STUDENT_RATE_LIMIT_DAY=100
MYTEE_GUEST_RATE_LIMIT_MIN=5
MYTEE_GUEST_RATE_LIMIT_DAY=20
MYTEE_TICKET_RATE_LIMIT_HOUR=3
MYTEE_ADMIN_RATE_LIMIT_MIN=30
MYTEE_MAX_MESSAGE_LENGTH=1200
MYTEE_MAX_HISTORY_TURNS=10

# EmailJS Service Configuration (Server-Side Delivery)
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
EMAILJS_WELCOME_TEMPLATE_ID=your_emailjs_welcome_template_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_access_token_if_api_strict_enabled
EMAILJS_ORIGIN=https://studymyte4students.vercel.app

# Security & OTP Configuration
OTP_LIFETIME_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SEC=60
MAX_RESENDS=3

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
